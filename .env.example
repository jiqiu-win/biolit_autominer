# Copy this file to .env and fill in your values:
#   cp .env.example .env

NCBI_EMAIL=your_email@university.edu
NCBI_API_KEY=your_ncbi_api_key_here

GEMINI_PROJECT_ID=your-gcp-project-id
GEMINI_MODEL=gemini-2.5-flash

# Optional paths (defaults shown)
OUTPUT_DIR=auto_pipeline_output
SEARCH_QUERY=
# Leave empty to use IEEE full query from prompts.py; or override here.
# SIMPLE fallback: hepatotoxicity AND mitochondrial

DOWNLOADS_DIR=downloaded
GEMINI_CACHE_DIR=gemini_raw_cache

# How often to write updated/ summary JSON: daily or monthly
UPDATE_FREQUENCY=daily

# PMC full-text staging: keep in updated/.../txt for N days before moving to downloaded/.../txt
PMC_STAGING_AGE_DAYS=1

# Two-tier extraction (NeurIPS budget workflow)
# Stage 1 cheap reader: deepseek or qwen
CHEAP_LLM_MODEL=deepseek
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-plus

# Stage 2 strong cleaner: gemini (default) or claude
STRONG_LLM_MODEL=gemini

LOG_LEVEL=INFO
